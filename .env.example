# ---- Centralised database (REQUIRED) -------------------------------------------------
# One Postgres shared by localhost, Vercel, phones and laptops. Free options: Neon, Supabase.
#   Neon:     postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# On Vercel add the same value under Settings > Environment Variables.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Only for a local Postgres without TLS (e.g. docker run postgres):  DATABASE_SSL=false
# DATABASE_SSL=false

# ---- Security -------------------------------------------------------------------------
# Shared key staff devices use to sync. Change it (the default "samket" is public).
SYNC_KEY=change-me
# Signs customer login tokens (defaults to SYNC_KEY if empty).
SESSION_SECRET=change-me-too

# ---- Telegram (optional) --------------------------------------------------------------
# Create a bot with @BotFather. TG_API_ID / TG_API_HASH are not needed for bot messages.
TG_BOT_TOKEN=
TG_BOT_USERNAME=
TG_STAFF_CHAT=
# Vercel has no always-on process, so use a webhook instead of polling:
#   set TG_WEBHOOK_SECRET to a random string, then call (once)
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://YOUR-SITE/api/tg&secret_token=<TG_WEBHOOK_SECRET>
TG_WEBHOOK_SECRET=

# ---- Bank transfer verification via Check.et (optional) ----------------------------------
# Business-account API key from https://check.et/dashboard (starts with chk_). Server-side only: NEVER prefix it with VITE_.
CHECK_ET_API_KEY=
# CHECK_ET_URL=https://api.check.et/api/v1

# ---- Google Maps (optional, public key restricted to your domain) ----
# VITE_GOOGLE_MAPS_KEY=
